# Public Supabase project settings. These values are exposed in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side Supabase access. Never expose the service role key to the browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Google OAuth flow used by the signup and login screens.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_AUTH_PROXY=

# Optional database restore hook settings used by api/db-wake.js.
FULLSTACK_PROJECT_REF=
FULLSTACK_RESTORE_API_URL=

# Optional integrations referenced by api/_social.js. Configure as server-only
# environment variables if you add official platform API support.
YOUTUBE_API_KEY=
TWITTER_BEARER_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
